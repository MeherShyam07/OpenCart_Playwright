{
  "name": "playwright_project",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test:api": "playwright test --grep @api --grep-invert @api-contract",
    "test:api-contract": "node utils/runApiContractTests.js",
    "test:web": "playwright test --grep @web",
    "test:master": "playwright test --grep @master --grep-invert @db",
    "test:sanity": "playwright test --grep @sanity",
    "test:regression": "playwright test --grep @regression --grep-invert @db",
    "test:e2e": "playwright test --grep \"(?=.*@web)(?=.*@end-to-end)\"",
    "test:datadriven": "playwright test --grep @datadriven",
    "test:db": "playwright test --grep @db",
    "test:master:headed": "playwright test --grep @sanity --headed",
    "test:sanity:debug": "playwright test --grep @sanity --debug"
  },
  "keywords": [],
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0",
    "dotenv": "^18.0.9"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@faker-js/faker": "^10.6.0",
    "csv-parse": "^7.0.3",
    "luxon": "^3.7.2",
    "mysql2": "^3.24.6",
    "xlsx": "^0.18.5"
  }
}
