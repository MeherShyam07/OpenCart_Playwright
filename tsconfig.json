{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "outDir": "dist",
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "api/**/*.ts",
    "fixtures/**/*.ts",
    "pages/**/*.ts",
    "playwright.config.ts",
    "tests/**/*.ts",
    "utils/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "allure-report",
    "allure-results",
    "custom-report",
    "dist",
    "playwright-report",
    "reports",
    "test-results"
  ]
}
